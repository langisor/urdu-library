  {
    "unit": 1,
    "chapter": 4,
    "type": "Exercise",
    "number": 4,
    "id": "Pien7788_U01Ch04Ex04.mp3",
    "data": {
      "dialogue": [
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "یہ سب سامان میرا ہے یا تمہارا؟",
          "Translation": "Is all this stuff mine or yours?",
          "Arabic": "هذه الأغراض كلها لي أم لك؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "کچھ میرا ہے اور کچھ تمہارا۔",
          "Translation": "Some is mine and some is yours.",
          "Arabic": "بعضها لي وبعضها لك."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "یہ کتاب کس کی ہے؟",
          "Translation": "Whose book is this?",
          "Arabic": "لمن هذا الكتاب؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "تمہاری ہے۔",
          "Translation": "It is yours.",
          "Arabic": "هو لك."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "اور کونسا قلم میرا ہے اور کونسا تمہارا؟",
          "Translation": "And which pen is mine and which is yours?",
          "Arabic": "وأي قلم لي وأي قلم لك؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "نیلا قلم میرا ہے اور کالا قلم تمہارا۔",
          "Translation": "The blue pen is mine and the black pen is yours.",
          "Arabic": "القلم الأزرق لي والقلم الأسود لك."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "کیا یہ پنسل بھی میری ہے؟",
          "Translation": "Is this pencil also mine?",
          "Arabic": "هل هذا القلم الرصاص لي أيضاً؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "نہیں، وہ میری ہے۔",
          "Translation": "No, that one is mine.",
          "Arabic": "لا، ذلك لي."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "اور یہاں کونسی کاپی میری ہے؟",
          "Translation": "And which notebook here is mine?",
          "Arabic": "وأي دفتر هنا لي؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "یہ دونوں کاپیاں تمہاری ہیں۔",
          "Translation": "Both of these notebooks are yours.",
          "Arabic": "هذان الدفتران لك."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "تمہاری کاپی کہاں گئی؟",
          "Translation": "Where did your notebook go?",
          "Arabic": "أين ذهب دفترك؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "میری کاپی نیلی ہے۔ وہ یہاں نہیں ہے۔",
          "Translation": "My notebook is blue. It is not here.",
          "Arabic": "دفترِي أزرق. هو ليس هنا."
        },
        {
          "Speaker": "کبير (Kabeer)",
          "Urdu": "کیا میری گھڑی بھی یہاں ہے؟",
          "Translation": "Is my watch here too?",
          "Arabic": "هل ساعتي هنا أيضاً؟"
        },
        {
          "Speaker": "جميلة (Jameela)",
          "Urdu": "نہیں، یہاں کوئی گھڑی نہیں ہے۔",
          "Translation": "No, there is no watch here.",
          "Arabic": "لا، لا توجد ساعة هنا."
        }
      ],
      "questions": [
        "A. Which items are Kabeer's?",
        "B. Which items are Jameela's?",
        "C. Which items mentioned are not present and to whom do they belong?"
      ],
      "answers": {
        "A": [
          "Book (کتاب)",
          "Black Pen (کالا قلم)",
          "Two Notebooks (دو کاپیاں)"
        ],
        "B": [
          "Blue Pen (نیلا قلم)",
          "Pencil (پنسل)"
        ],
        "C": [
          "Jameela's Blue Notebook (میری کاپی نیلی)",
          "Kabeer's Watch (میری گھڑی)"
        ]
      }
    }
  },
