 {
  "unit": 1,
  "chapter": 1,
  "type": "Vocabulary",
  "number": 4,
  "id": "Pien7788_U01Ch01V04.mp3",
  "table": {
   "header": {
    "English": "English",
    "Transliteration": "Transliteration (Urdu Romanization)",
    "Urdu": "Urdu Script",
    "Arabic": "Arabic Translation",
    "Image": "Image Link (Optional)"
   },
   "data": [
    {
     "English": "a term of respect appended to male names",
     "Transliteration": "sāhab",
     "Urdu": "صاحب",
     "Arabic": "سيد / أستاذ",
     "Image": ""
    },
    {
     "English": "the equivalent term for use with female names",
     "Transliteration": "sāhiba",
     "Urdu": "صاحبه",
     "Arabic": "سيدة / أستاذة",
     "Image": ""
    },
    {
     "English": "How are you? \"What is (your) condition?\"",
     "Transliteration": "kyā hāl hai?",
     "Urdu": "کیا حال ہے؟",
     "Arabic": "كيف حالك؟",
     "Image": ""
    },
    {
     "English": "Everything is well.",
     "Transliteration": "sab xairiyat hai.",
     "Urdu": "سب خیریت ہے-",
     "Arabic": "كل شيء بخير.",
     "Image": ""
    },
    {
     "English": "I am well.",
     "Transliteration": "mai xairiyat se hū̃-.",
     "Urdu": "میں خیریت سے ہوں۔",
     "Arabic": "أنا بخير.",
     "Image": ""
    },
    {
     "English": "How are you?",
     "Transliteration": "āp kaise / kaisī hai?",
     "Urdu": "آپ کیسے / کیسی ہے؟",
     "Arabic": "كيف حالك؟ (للمذكر / للمؤنث)",
     "Image": ""
    },
    {
     "English": "Thanks to God (I'm well).",
     "Transliteration": "xudā kā śukr hai.",
     "Urdu": "خدا کا شکر ہے۔",
     "Arabic": "الحمد لله.",
     "Image": ""
    },
    {
     "English": "I'm well. \"It is your blessing (that keeps me well)\"",
     "Transliteration": "āp kī duā hai.",
     "Urdu": "آپ کی دعا ہے۔",
     "Arabic": "بخير. (ببركة دعواتك)",
     "Image": ""
    },
    {
     "English": "You are...",
     "Transliteration": "āp ...hai.",
     "Urdu": "آپ ۔۔۔ ہیں۔",
     "Arabic": "أنت تكون...",
     "Image": ""
    },
    {
     "English": "I am...",
     "Transliteration": "mai ...hū̃-.",
     "Urdu": "میں ۔۔۔ ہوں۔",
     "Arabic": "أنا أكون...",
     "Image": ""
    },
    {
     "English": "Where are you from?",
     "Transliteration": "āp kahā̃ se hai?",
     "Urdu": "آپ کہاں سے ہیں؟",
     "Arabic": "من أين أنت؟",
     "Image": ""
    },
    {
     "English": "I'm from...",
     "Transliteration": "mai ...se hū̃-.",
     "Urdu": "میں ۔۔۔ سے ہوں۔",
     "Arabic": "أنا من...",
     "Image": ""
    },
    {
     "English": "Please give me permission (to leave) (used to wrap up a conversation before leaving)",
     "Transliteration": "ijāzat dījiye.",
     "Urdu": "إجازت دیجیے۔",
     "Arabic": "من فضلك اسمح لي بالمغادرة.",
     "Image": ""
    },
    {
     "English": "Goodbye. (Allah is the protector)",
     "Transliteration": "allāh hāfiz.",
     "Urdu": "الله حافظ-",
     "Arabic": "إلى اللقاء. (الله الحافظ)",
     "Image": ""
    }
   ]
  }
 },
